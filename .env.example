# CLERK
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# LANGSMITH
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=anatomy
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# OPENAI
OPENAI_API_KEY=

# OPENROUTER (optional - alternative to OpenAI)
# OPENROUTER_API_KEY=
# OPENROUTER_HTTP_REFERER=http://localhost:3000

# Any OpenAI-compatible endpoint. Leave all four unset for OpenAI itself.
# Set them to use another provider, and the model is still pinned, and still
# part of the cache key, so old answers stop matching rather than being served.
#
#   Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1
#
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL_EXPLAIN=
# AI_MODEL_CLASSIFY=
# AI_MODEL_QUESTION=

# Custom model limits (Phase 1D, V4). Required when AI_MODEL_* names a model
# that is not in the verified KNOWN_MODEL_LIMITS table (lib/ai/budget.ts):
# without them the profile falls back to conservative unknown-model defaults
# (13,500-character input ceiling, 4,500 operational input tokens, 8,192
# context window), retrieval is capped accordingly, and the first answer per
# process logs a one-line warning. Both values must leave headroom: maxOutput
# at least 1,000 tokens below contextWindow.
#
# AI_CONTEXT_WINDOW_TOKENS=
# AI_MAX_OUTPUT_TOKENS=