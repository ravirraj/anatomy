# CLERK
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# LANGSMITH
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=anatomy
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# OPENAI
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint. Leave all four unset for OpenAI itself.
# Set them to use another provider, and the model is still pinned, and still
# part of the cache key, so old answers stop matching rather than being served.
#
#   Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1
#
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL_EXPLAIN=
# AI_MODEL_CLASSIFY=